# Public legal details rendered by server-side policy pages.
# Required before production checkout or public forms: use the exact HTTPS storefront origin.
# Do not leave this as localhost on the deployed application.
SITE_URL=http://localhost:3000

# Supabase browser-safe project settings from Project Settings > API.
# The publishable key is designed for browsers; never place a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server-only key for trusted webhooks and background operations.
# Prefer a modern secret key. Never expose it through a NEXT_PUBLIC_ variable.
SUPABASE_SECRET_KEY=

# Keep checkout disabled until EasyPost rates, Stripe test payments, and fulfillment are verified.
CHECKOUT_ENABLED=false
# EasyPost test key for local testing; use a production key only after carrier and parcel validation.
EASYPOST_API_KEY=
# Exact address parcels ship FROM. Configure all required fields before enabling checkout.
EASYPOST_ORIGIN_NAME=OralNex
EASYPOST_ORIGIN_STREET=1912 Sherwood Way
EASYPOST_ORIGIN_STREET2=
EASYPOST_ORIGIN_CITY=San Angelo
EASYPOST_ORIGIN_STATE=TX
EASYPOST_ORIGIN_ZIP=76901
# Stripe publishable key is intentionally browser-visible. Use a key from the same mode/account as STRIPE_SECRET_KEY.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Secret key and webhook signing secret are server-only. Never prefix either with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Enable only after Stripe Tax is registered and configured for the business.
STRIPE_AUTOMATIC_TAX_ENABLED=false

# Transactional order emails. Enable only after verifying the sender domain in Resend.
ORDER_EMAIL_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
ORDER_EMAIL_FROM=OralNex Orders <orders@updates.example.com>
# If ORDER_EMAIL_FROM is empty, order emails use REQUEST_EMAIL_FROM.
# Use a verified Resend domain for delivery to buyers; onboarding@resend.dev is test-only.
# Monitored inbox (for example info@oralnex.com). Customer-facing emails use this as Reply-To.
ADMIN_NOTIFICATION_EMAIL=

# Contact-form emails. Uses the same Resend key and admin recipient above.
REQUEST_EMAIL_NOTIFICATIONS_ENABLED=false
REQUEST_EMAIL_FROM=OralNex Customer Care <support@updates.example.com>

# Error and performance monitoring. The DSN is intentionally browser-visible.
# Keep the auth token server-side; it is used only to upload source maps during builds.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Use matching environment names for browser and server, e.g. staging or production.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=staging
SENTRY_ENVIRONMENT=staging
# Optional for runtime events; required with SENTRY_AUTH_TOKEN for source-map uploads.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
